        {
          "sid": "S5",
          "kind": "ui",
          "desc": "再次点击联系酒店唤起弹窗检查文案常驻",
          "action": "tap-text",
          "action_arg": "联系酒店",
          "step-type": "interaction",
          "page_ready": true,
          "asserts": [
            {
              "kind": "text",
              "match": "present",
              "expect": "将使用该号码加密呼出"
