      "flow_source": "/Users/crazcdll07/.skills-manager/skills/ai-ui-autotest-engine/.run/tasks/0d2bdc40/inputs/flows/Flow06-协商取消页呼出_修改弹窗-双卡引导文案双态展示.md",
