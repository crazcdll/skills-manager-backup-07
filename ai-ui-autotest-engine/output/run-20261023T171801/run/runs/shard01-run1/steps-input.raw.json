    {
      "case_id": "Flow01-订单详情页呼出弹窗-展示态双卡引导文案展示",
      "case_name": "Flow01-订单详情页呼出弹窗-展示态双卡引导文案展示",
      "landing_scheme": "imeituan://www.meituan.com/mrn?mrn_biz=hotel&mrn_entry=hotelchannel-order-detail&mrn_component=hotelchannel-order-detail&order_id={order_id}&biz_type=1",
      "params": {
        "order_id": "5035036077836749951"
      },
      "steps": [
        {
          "sid": "S1",
          "kind": "ui",
          "desc": "滚动到「联系酒店」入口",
          "action": "scroll-until",
          "action_arg": "联系酒店",
          "step-type": "interaction",
          "page_ready": false,
          "asserts": [
            {
              "kind": "text",
              "match": "present",
              "expect": "联系酒店"
            }
          ],
          "direction": "down"
        },
        {
          "sid": "S2",
          "kind": "ui",
          "desc": "开：点击「联系酒店」唤起号码呼出弹窗",
          "action": "tap-text",
          "action_arg": "联系酒店",
          "step-type": "interaction",
          "page_ready": true,
          "asserts": [
            {
              "kind": "text",
              "match": "present",
              "expect": "将使用该号码加密呼出"
            }
          ]
        },
        {
          "sid": "A1",
          "kind": "api",
          "desc": "queryuserinfo 接口返回校验",
          "api_assert": {
            "path": "/hotelorder/v1/queryuserinfo.json",
            "expected_fields": [
              {
                "source": "meta",
                "field": "http_code",
                "expected": "200"
              },
              {
                "source": "response",
                "field": "error.code",
                "expected": "200"
              },
              {
                "source": "response",
                "field": "data.maskMobile",
                "expected": "非空掩码本机号，与弹窗号码区展示一致"
              }
            ]
          }
        },
        {
          "sid": "S3",
          "kind": "ui",
          "desc": "看：展示态弹窗双卡引导文案与样式",
          "action": "assert-text",
          "step-type": "assert",
          "asserts": [
            {
              "kind": "text",
              "match": "present",
              "expect": "双卡双待请确认，系统呼出号码和下方一致"
            },
            {
              "kind": "text",
              "match": "present",
              "expect": "为保证服务质量，您的通话可能被录音"
            },
            {
              "kind": "text",
              "match": "present",
              "expect": "非本机号请修改"
            },
            {
              "kind": "text",
              "match": "present",
              "expect": "立即呼叫"
            },
            {
              "kind": "text",
              "match": "present",
              "expect": "取消"
            },
            {
              "kind": "visual",
              "expect": "「双卡双待请确认，系统呼出号码和下方一致」位于「将使用该号码加密呼出」正下方、号码区上方"
            },
            {
              "kind": "visual",
              "expect": "「双卡双待请确认，系统呼出号码和下方一致」样式与 UI 稿一致：12pt、#999999、居中，且截图包含标题/双卡文案/号码区/按钮"
            }
          ]
        },
        {
          "sid": "S4",
          "kind": "ui",
          "desc": "关：点击「取消」关闭弹窗",
          "action": "tap-text",
          "action_arg": "取消",
          "step-type": "interaction",
          "page_ready": false,
          "asserts": [
            {
              "kind": "text",
              "match": "gone",
              "expect": "将使用该号码加密呼出"
            }
          ]
        },
        {
          "sid": "S5",
          "kind": "ui",
          "desc": "开：再次点击「联系酒店」唤起弹窗",
          "action": "tap-text",
          "action_arg": "联系酒店",
          "step-type": "interaction",
          "page_ready": true,
          "asserts": [
            {
              "kind": "text",
              "match": "present",
              "expect": "将使用该号码加密呼出"
            }
          ]
        },
        {
          "sid": "S5b",
          "kind": "ui",
          "desc": "看：再次唤起后双卡引导文案常驻展示",
          "action": "assert-text",
          "step-type": "assert",
          "asserts": [
            {
              "kind": "text",
              "match": "present",
              "expect": "双卡双待请确认，系统呼出号码和下方一致"
            }
          ]
        }
      ],
