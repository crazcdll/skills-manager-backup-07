      "landing_scheme": "imeituan://www.meituan.com/mrn?mrn_biz=hotel&mrn_entry=hotelchannel-order-detail&mrn_component=hotelchannel-order-detail&order_id=5035036077836749951&biz_type=1&mrn_disable_debugview=true&disableRedBox=1&disableDebugView=true&__recce_dev_show__=false",
