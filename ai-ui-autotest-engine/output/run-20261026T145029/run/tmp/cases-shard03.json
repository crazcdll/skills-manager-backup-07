{
  "batch_name": "shard-03 隐私号双卡引导 Flow05/Flow06",
  "device": {
    "type": "sandbox",
    "platform": "android",
    "app": "meituan",
    "auto_install": false
  },
  "cases": [
    {
      "case_id": "Flow05-订单详情页联系电话入口-商家号码保持现状",
      "case_name": "Flow05-订单详情页联系电话入口-商家号码保持现状",
      "landing_scheme": "imeituan://www.meituan.com/mrn?mrn_biz=hotel&mrn_entry=hotelchannel-order-detail&mrn_component=hotelchannel-order-detail&order_id={order_id}&biz_type=1",
      "params": {
        "order_id": "5035036077836749951"
      },
      "steps": [
        {
          "sid": "S1",
          "kind": "ui",
          "desc": "滚动到联系酒店入口区域",
          "action": "scroll-until",
          "action_arg": "联系酒店",
          "direction": "down",
          "step-type": "interaction",
          "page_ready": false,
          "asserts": [
            {"kind": "text", "match": "present", "expect": "联系酒店"}
          ]
        },
        {
          "sid": "S2",
          "kind": "ui",
          "desc": "检查联系电话入口商家号码展示保持现状",
          "action": "assert-text",
          "step-type": "assert",
          "asserts": [
            {"kind": "visual", "expect": "联系电话入口区域展示商家真实号码，保持现状（未隐去商家号码）"},
            {"kind": "text", "match": "gone", "expect": "电话一"},
            {"kind": "text", "match": "gone", "expect": "电话二"}
          ]
        }
      ]
    },
    {
      "case_id": "Flow06-协商取消页呼出_修改弹窗-双卡引导文案双态展示",
      "case_name": "Flow06-协商取消页呼出_修改弹窗-双卡引导文案双态展示",
      "landing_scheme": "imeituan://www.meituan.com/mrn?mrn_biz=hotel&mrn_entry=hotelchannel-order-detail&mrn_component=hotelchannel-order-detail&order_id={negotiation_order_id}&biz_type=1",
      "params": {
        "negotiation_order_id": "5035036077836749951"
      },
      "mock_ids": ["19538157", "19538201"],
      "steps": [
        {
          "sid": "S1",
          "kind": "ui",
          "desc": "从订单详情页点击取消订单进入协商取消页",
          "action": "tap-text",
          "action_arg": "取消订单",
          "step-type": "interaction",
          "page_ready": true,
          "asserts": [
            {"kind": "visual", "expect": "取消流程/协商取消页展示"}
          ]
        },
        {
          "sid": "S2",
          "kind": "ui",
          "desc": "协商取消页点击联系酒店唤起号码呼出弹窗",
          "action": "tap-text",
          "action_arg": "联系酒店",
          "step-type": "interaction",
          "page_ready": true,
          "asserts": [
            {"kind": "text", "match": "present", "expect": "将使用该号码加密呼出"}
          ]
        },
        {
          "sid": "S3",
          "kind": "ui",
          "desc": "断言呼出弹窗双卡引导文案（展示态）",
          "action": "assert-text",
          "step-type": "assert",
          "asserts": [
            {"kind": "text", "match": "present", "expect": "将使用该号码加密呼出"},
            {"kind": "text", "match": "present", "expect": "双卡双待请确认，系统呼出号码和下方一致"},
            {"kind": "visual", "expect": "「双卡双待请确认，系统呼出号码和下方一致」位于弹窗标题正下方"}
          ]
        },
        {
          "sid": "A1",
          "kind": "api",
          "desc": "queryuserinfo 接口返回校验",
          "api_assert": {
            "path": "/hotelorder/v1/queryuserinfo.json",
            "expected_fields": [
              {"source": "response", "field": "error.code", "expected": "200"},
              {"source": "response", "field": "maskMobile", "expected": "正常返回"}
            ]
          }
        },
        {
          "sid": "S4",
          "kind": "ui",
          "desc": "进入修改号码流程查看编辑态弹窗文案",
          "action": "tap-text",
          "action_arg": "非本机号请修改",
          "step-type": "interaction",
          "page_ready": true,
          "asserts": [
            {"kind": "text", "match": "present", "expect": "输入本机号码"}
          ]
        },
        {
          "sid": "S5",
          "kind": "ui",
          "desc": "断言编辑态弹窗双卡引导文案",
          "action": "assert-text",
          "step-type": "assert",
          "asserts": [
            {"kind": "text", "match": "present", "expect": "双卡双待请确认，系统呼出号码和下方一致"},
            {"kind": "text", "match": "present", "expect": "请输入本机号码"}
          ]
        },
        {
          "sid": "S6",
          "kind": "ui",
          "desc": "关闭弹窗",
          "action": "tap-text",
          "action_arg": "取消",
          "step-type": "interaction",
          "page_ready": false,
          "asserts": [
            {"kind": "text", "match": "gone", "expect": "输入本机号码"}
          ]
        }
      ]
    }
  ]
}
