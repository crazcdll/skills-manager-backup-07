{
  "batch_name": "隐私号呼出弹窗-双卡引导文案（shard-01）",
  "device": {"type": "sandbox", "platform": "android", "app": "meituan", "auto_install": false},
  "cases": [
    {
      "case_id": "Flow01-订单详情页呼出弹窗-展示态双卡引导文案展示",
      "case_name": "Flow01-订单详情页呼出弹窗-展示态双卡引导文案展示",
      "landing_scheme": "imeituan://www.meituan.com/mrn?mrn_biz=hotel&mrn_entry=hotelchannel-order-detail&mrn_component=hotelchannel-order-detail&order_id={order_id}&biz_type=1",
      "params": {"order_id": "5035036077836749951"},
      "steps": [
        {
          "sid": "S1",
          "kind": "ui",
          "desc": "滚动到联系酒店入口",
          "action": "scroll-until",
          "action_arg": "联系酒店",
          "step-type": "interaction",
          "page_ready": false,
          "asserts": [{"kind": "text", "match": "present", "expect": "联系酒店"}]
        },
        {
          "sid": "S2",
          "kind": "ui",
          "desc": "L1 点击联系酒店唤起商家号浮层",
          "action": "tap-text",
          "action_arg": "联系酒店",
          "step-type": "interaction",
          "page_ready": true,
          "asserts": [{"kind": "visual", "expect": "底部浮层出现「咨询酒店」标题与「在线联系」「电话联系」两项联系方式（此层仅为商家号浮层）"}]
        },
        {
          "sid": "S3",
          "kind": "ui",
          "desc": "L2 点击浮层内电话联系行唤起号码选择弹窗",
          "action": "tap-text",
          "action_arg": "电话联系",
          "step-type": "interaction",
          "page_ready": true,
          "asserts": [{"kind": "visual", "expect": "出现居中号码选择弹窗，列出酒店号码（010-53913316 / 18519274883）与「取消」"}]
        },
        {
          "sid": "S4",
          "kind": "ui",
          "desc": "L3 点击第一个酒店号码唤起隐私号呼出弹窗",
          "action": "tap",
          "action_x": 360,
          "action_y": 900,
          "step-type": "interaction",
          "page_ready": true,
          "asserts": [{"kind": "visual", "expect": "出现隐私号呼出弹窗，标题为「将使用该号码加密呼出」"}]
        },
        {
          "sid": "S5",
          "kind": "ui",
          "desc": "查看展示态弹窗标题与录音提示文案",
          "action": "assert-text",
          "step-type": "assert",
          "asserts": [
            {"kind": "visual", "expect": "弹窗标题展示「将使用该号码加密呼出」"},
            {"kind": "visual", "expect": "弹窗底部展示「为保证服务质量，您的通话可能被录音」"}
          ]
        },
        {
          "sid": "A1",
          "kind": "api",
          "desc": "queryuserinfo 接口返回校验（error.code=200，maskMobile 非空）",
          "api_assert": {
            "path": "/hotelorder/v1/queryuserinfo.json",
            "expected_fields": [
              {"source": "response", "field": "error.code", "expected": "200"},
              {"source": "response", "field": "data.maskMobile", "expected": "掩码本机号，如 185****7674"}
            ]
          }
        },
        {
          "sid": "S6",
          "kind": "ui",
          "desc": "查看展示态弹窗双卡引导文案与位置样式",
          "action": "assert-text",
          "step-type": "assert",
          "asserts": [
            {"kind": "visual", "expect": "弹窗内展示「双卡双待请确认，系统呼出号码和下方一致」"},
            {"kind": "visual", "expect": "该双卡文案位于标题「将使用该号码加密呼出」正下方、掩码号码区上方"},
            {"kind": "visual", "expect": "该双卡文案为小号灰色字（约 12pt / #999999）且水平居中，与 UI 稿一致"},
            {"kind": "visual", "expect": "弹窗内展示「非本机号请修改」入口"},
            {"kind": "visual", "expect": "弹窗内展示「立即呼叫」按钮"},
            {"kind": "visual", "expect": "弹窗内展示「取消」按钮"}
          ]
        },
        {
          "sid": "S7",
          "kind": "ui",
          "desc": "点击取消关闭隐私号呼出弹窗",
          "action": "tap",
          "action_x": 223,
          "action_y": 659,
          "step-type": "interaction",
          "page_ready": false,
          "asserts": [{"kind": "visual", "expect": "隐私号呼出弹窗已关闭，标题「将使用该号码加密呼出」不再展示"}]
        },
        {
          "sid": "S8",
          "kind": "ui",
          "desc": "点击取消关闭号码选择弹窗回到订单详情页",
          "action": "tap",
          "action_x": 360,
          "action_y": 1128,
          "step-type": "interaction",
          "page_ready": false,
          "asserts": [{"kind": "visual", "expect": "号码选择弹窗已关闭，页面回到订单详情页"}]
        },
        {
          "sid": "S9",
          "kind": "ui",
          "desc": "第二轮 L1 点击联系酒店",
          "action": "tap-text",
          "action_arg": "联系酒店",
          "step-type": "interaction",
          "page_ready": true,
          "asserts": [{"kind": "visual", "expect": "底部商家号浮层再次出现"}]
        },
        {
          "sid": "S10",
          "kind": "ui",
          "desc": "第二轮 L2 点击电话联系行",
          "action": "tap-text",
          "action_arg": "电话联系",
          "step-type": "interaction",
          "page_ready": true,
          "asserts": [{"kind": "visual", "expect": "号码选择弹窗再次出现"}]
        },
        {
          "sid": "S11",
          "kind": "ui",
          "desc": "第二轮 L3 点击第一个酒店号码",
          "action": "tap",
          "action_x": 360,
          "action_y": 900,
          "step-type": "interaction",
          "page_ready": true,
          "asserts": [{"kind": "visual", "expect": "隐私号呼出弹窗再次出现"}]
        },
        {
          "sid": "S12",
          "kind": "ui",
          "desc": "再次唤起后校验双卡引导文案常驻展示",
          "action": "assert-text",
          "step-type": "assert",
          "asserts": [{"kind": "visual", "expect": "再次唤起的弹窗内仍展示「双卡双待请确认，系统呼出号码和下方一致」（常驻性成立）"}]
        }
      ]
    },
    {
      "case_id": "Flow02-订单详情页修改弹窗-编辑态双卡引导文案展示",
      "case_name": "Flow02-订单详情页修改弹窗-编辑态双卡引导文案展示",
      "landing_scheme": "imeituan://www.meituan.com/mrn?mrn_biz=hotel&mrn_entry=hotelchannel-order-detail&mrn_component=hotelchannel-order-detail&order_id={order_id}&biz_type=1",
      "params": {"order_id": "5035036077836749951"},
      "steps": [
        {
          "sid": "S1",
          "kind": "ui",
          "desc": "L1 点击联系酒店唤起商家号浮层",
          "action": "tap-text",
          "action_arg": "联系酒店",
          "step-type": "interaction",
          "page_ready": true,
          "asserts": [{"kind": "visual", "expect": "底部浮层出现「咨询酒店」标题与「在线联系」「电话联系」两项联系方式"}]
        },
        {
          "sid": "S2",
          "kind": "ui",
          "desc": "L2 点击浮层内电话联系行唤起号码选择弹窗",
          "action": "tap-text",
          "action_arg": "电话联系",
          "step-type": "interaction",
          "page_ready": true,
          "asserts": [{"kind": "visual", "expect": "出现居中号码选择弹窗，列出酒店号码（010-53913316 / 18519274883）与「取消」"}]
        },
        {
          "sid": "S3",
          "kind": "ui",
          "desc": "L3 点击第一个酒店号码唤起隐私号呼出弹窗（展示态）",
          "action": "tap",
          "action_x": 360,
          "action_y": 900,
          "step-type": "interaction",
          "page_ready": true,
          "asserts": [{"kind": "visual", "expect": "出现隐私号呼出弹窗，标题为「将使用该号码加密呼出」"}]
        },
        {
          "sid": "S4",
          "kind": "ui",
          "desc": "确认展示态弹窗已就绪",
          "action": "assert-text",
          "step-type": "assert",
          "asserts": [{"kind": "visual", "expect": "弹窗标题「将使用该号码加密呼出」已展示，掩码本机号区域可见"}]
        },
        {
          "sid": "S5",
          "kind": "ui",
          "desc": "点击非本机号请修改进入编辑态",
          "action": "tap",
          "action_anchor": "非本机号请修改",
          "step-type": "interaction",
          "page_ready": true,
          "asserts": [{"kind": "visual", "expect": "出现修改本机号码弹窗（编辑态），标题为「输入本机号码」"}]
        },
        {
          "sid": "S6",
          "kind": "ui",
          "desc": "查看编辑态弹窗标题与输入提示文案",
          "action": "assert-text",
          "step-type": "assert",
          "asserts": [
            {"kind": "visual", "expect": "编辑态弹窗标题展示「输入本机号码」"},
            {"kind": "visual", "expect": "输入框提示文案展示「请输入本机号码」"}
          ]
        },
        {
          "sid": "A1",
          "kind": "api",
          "desc": "queryuserinfo 接口返回校验（error.code=200）",
          "api_assert": {
            "path": "/hotelorder/v1/queryuserinfo.json",
            "expected_fields": [
              {"source": "response", "field": "error.code", "expected": "200"}
            ]
          }
        },
        {
          "sid": "S7",
          "kind": "ui",
          "desc": "查看编辑态弹窗双卡引导文案与位置",
          "action": "assert-text",
          "step-type": "assert",
          "asserts": [
            {"kind": "visual", "expect": "编辑态弹窗内展示「双卡双待请确认，系统呼出号码和下方一致」"},
            {"kind": "visual", "expect": "该双卡文案位于「输入本机号码」标题下方"},
            {"kind": "visual", "expect": "编辑态弹窗内展示「立即呼叫」按钮"},
            {"kind": "visual", "expect": "编辑态弹窗内展示「取消」按钮"}
          ]
        },
        {
          "sid": "S8",
          "kind": "ui",
          "desc": "点击取消关闭编辑态弹窗",
          "action": "tap",
          "action_anchor": "取消",
          "step-type": "interaction",
          "page_ready": false,
          "asserts": [{"kind": "visual", "expect": "编辑态弹窗已关闭"}]
        },
        {
          "sid": "S9",
          "kind": "ui",
          "desc": "确认编辑态弹窗文案消失",
          "action": "assert-text",
          "step-type": "assert",
          "asserts": [{"kind": "visual", "expect": "页面不再展示「输入本机号码」编辑态弹窗"}]
        },
        {
          "sid": "S10",
          "kind": "ui",
          "desc": "重新唤起：L1 点击联系酒店",
          "action": "tap-text",
          "action_arg": "联系酒店",
          "step-type": "interaction",
          "page_ready": true,
          "asserts": [{"kind": "visual", "expect": "底部商家号浮层再次出现"}]
        },
        {
          "sid": "S11",
          "kind": "ui",
          "desc": "重新唤起：L2 点击电话联系行",
          "action": "tap-text",
          "action_arg": "电话联系",
          "step-type": "interaction",
          "page_ready": true,
          "asserts": [{"kind": "visual", "expect": "号码选择弹窗再次出现"}]
        },
        {
          "sid": "S12",
          "kind": "ui",
          "desc": "重新唤起：L3 点击第一个酒店号码",
          "action": "tap",
          "action_x": 360,
          "action_y": 900,
          "step-type": "interaction",
          "page_ready": true,
          "asserts": [{"kind": "visual", "expect": "隐私号呼出弹窗（展示态）再次出现"}]
        },
        {
          "sid": "S13",
          "kind": "ui",
          "desc": "校验再次唤起的展示态弹窗文案",
          "action": "assert-text",
          "step-type": "assert",
          "asserts": [
            {"kind": "visual", "expect": "弹窗内展示「双卡双待请确认，系统呼出号码和下方一致」"},
            {"kind": "visual", "expect": "弹窗内展示「将使用该号码加密呼出」"}
          ]
        },
        {
          "sid": "S14",
          "kind": "ui",
          "desc": "再次进入编辑态",
          "action": "tap",
          "action_anchor": "非本机号请修改",
          "step-type": "interaction",
          "page_ready": true,
          "asserts": [{"kind": "visual", "expect": "再次出现「输入本机号码」编辑态弹窗"}]
        },
        {
          "sid": "S15",
          "kind": "ui",
          "desc": "校验编辑态双卡文案不丢失不重复",
          "action": "assert-text",
          "step-type": "assert",
          "asserts": [
            {"kind": "visual", "expect": "编辑态弹窗内展示「双卡双待请确认，系统呼出号码和下方一致」"},
            {"kind": "visual", "expect": "该双卡文案在弹窗内仅出现一次（无重复渲染）"}
          ]
        }
      ]
    }
  ]
}
